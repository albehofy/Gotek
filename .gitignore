# ==============================================================================
# Git Ignore - Media Glow CRM Platform (Laravel + Angular)
# ==============================================================================

# Dependencies
node_modules/
vendor/
.npm/

# Environment and sensitive configuration
.env
.env.backup
.env.local
.env.production
.env.staging
.env.*.local
!.env.example
!.env.*.example
auth.json

# Build outputs and compilation caches
dist/
tmp/
out-tsc/
bazel-out/
**/.angular/cache/
.sass-cache/
*.tsbuildinfo
*.db-lock

# Laravel framework generated files & storage
**/storage/*.key
**/storage/framework/cache/*
!**/storage/framework/cache/.gitkeep
!**/storage/framework/cache/.gitignore
**/storage/framework/cache/data/*
!**/storage/framework/cache/data/.gitkeep
!**/storage/framework/cache/data/.gitignore
**/storage/framework/sessions/*
!**/storage/framework/sessions/.gitkeep
!**/storage/framework/sessions/.gitignore
**/storage/framework/views/*
!**/storage/framework/views/.gitkeep
!**/storage/framework/views/.gitignore
**/storage/framework/testing/*
!**/storage/framework/testing/.gitkeep
!**/storage/framework/testing/.gitignore
**/storage/pail/*
**/public/build/
**/public/hot/
**/public/storage
.phpunit.result.cache
.phpunit.cache
Homestead.json
Homestead.yaml

# Archives and Database exports
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.sql
!backend/database/*.sql
!backend_production/backend/database/*.sql

# Uploads & User-generated files
uploads/*
!uploads/.gitkeep

# Logs and Debug outputs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Generated Files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# IDE and Editor configurations
.idea/
.fleet/
.nova/
.zed/
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# VS Code (preserve shared settings/extensions if desired)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
